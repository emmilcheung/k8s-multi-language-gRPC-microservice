# Chart dependencies downloaded by 'helm dependency build'
# The "charts" folder is generally ignored and rebuilt by CI/CD pipelines.
charts/

# Packaged charts
*.tgz

# Dependency lock file (optional, but often regenerated by CI)
# Chart.lock

# IDE/Editor files (examples)
.idea/
.vscode/
*.iml
.DS_Store
temp/
target/

# OS and build artifacts
/bin
build/
dist/

# Sensitive or user-specific files
*.env
*.secret
credentials.json
