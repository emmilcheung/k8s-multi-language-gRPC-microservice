# infra/local/secrets.env.example
#
# Copy this file to secrets.env and fill in the values below.
# secrets.env is gitignored — never commit it.
#
#   cp infra/local/secrets.env.example infra/local/secrets.env
#
# Three values need to be set manually:
#   RSA_PRIVATE_KEY    — RS256 private key used by auth-service to sign JWTs
#   KONG_RSA_PUBLIC_KEY — matching RS256 public key used by Kong to validate JWTs
#   STRIPE_SECRET_KEY  — Stripe test key used by payment-service
#
# All other credentials (DB passwords, Redis, Mongo) are fixed local-only
# values baked into values-local.yaml and setup.sh — no need to set them here.

# ── RSA private key (PKCS#8 PEM, no passphrase) ──────────────────────────────
# Generate with:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:4096 \
#     -out infra/local/rsa_local.pem
# Then paste the full PEM content on a single line with literal \n:
#   awk 'NF {printf "%s\\n", $0}' infra/local/rsa_local.pem
#
# Example format (replace entirely):
#   RSA_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n
RSA_PRIVATE_KEY=REPLACE_ME_WITH_PRIVATE_KEY_PEM_CONTENT

# ── RSA public key (SPKI PEM) ─────────────────────────────────────────────────
# The matching public key for RSA_PRIVATE_KEY above.
# Kong uses this to validate JWTs. Extract from the private key with:
#   openssl rsa -in infra/local/rsa_local.pem -pubout -out infra/local/rsa_local_pub.pem
# Then paste as a single line with literal \n:
#   awk 'NF {printf "%s\\n", $0}' infra/local/rsa_local_pub.pem
#
# Example format (replace entirely):
#   KONG_RSA_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\nMIIB...\n-----END PUBLIC KEY-----\n
KONG_RSA_PUBLIC_KEY=REPLACE_ME_WITH_PUBLIC_KEY_PEM_CONTENT

# ── Stripe test secret key ────────────────────────────────────────────────────
# For local dev without real Stripe, set to exactly "test_mock":
#   STRIPE_SECRET_KEY=test_mock
# For real Stripe test transactions, use your test key from:
#   https://dashboard.stripe.com/test/apikeys (starts with sk_test_)
STRIPE_SECRET_KEY=test_mock
