# infra/local/secrets.env.example
#
# Copy this file to secrets.env and fill in the values below.
# secrets.env is gitignored — never commit it.
#
#   cp infra/local/secrets.env.example infra/local/secrets.env
#
# Five values need to be set manually:
#   RSA_PRIVATE_KEY    — RS256 private key used by auth-service to sign JWTs
#   KONG_RSA_PUBLIC_KEY — matching RS256 public key used by Kong to validate JWTs
#   X_USER_ID_SIGNING_KEY — HMAC key used by Kong and internal services to sign user IDs
#   STRIPE_SECRET_KEY  — Stripe test key used by payment-service
#   QR_SIGNING_KEY     — shared secret used by attendance-service to sign QR tokens
#
# All other credentials (DB passwords, Redis, Mongo) are fixed local-only
# values baked into values-local.yaml and setup.sh — no need to set them here.

# ── RSA private key (PKCS#8 PEM, no passphrase) ──────────────────────────────
# IMPORTANT: This key is ONLY for local development.
# DO NOT commit infra/local/rsa_local.pem to git. It is listed in .gitignore.
# DO NOT paste real private key material into this file — secrets.env is gitignored
# for a reason. If this file is ever committed by accident, rotate the key immediately
# (see RSA Key Rotation below).
#
# Generate a new local key with:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:4096 \
#     -out infra/local/rsa_local.pem
#
# Then paste the full PEM content as a single line with literal \n:
#   awk 'NF {printf "%s\\n", $0}' infra/local/rsa_local.pem
#
# Example format (replace entirely):
#   RSA_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n
#
# ── RSA Key Rotation (Local Development) ──────────────────────────────────────
# If RSA_PRIVATE_KEY is ever exposed (e.g., committed to git by accident, stored in
# logs, or shared in Slack), regenerate it immediately:
#
#   1. Generate a new RSA key pair:
#      openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:4096 \
#        -out infra/local/rsa_local_NEW.pem
#
#   2. Extract the public key:
#      openssl rsa -in infra/local/rsa_local_NEW.pem -pubout \
#        -out infra/local/rsa_local_pub_NEW.pem
#
#   3. Update secrets.env with new private key:
#      awk 'NF {printf "%s\\n", $0}' infra/local/rsa_local_NEW.pem
#      (Copy output into RSA_PRIVATE_KEY below with \n escaping)
#
#   4. Update secrets.env with new public key:
#      awk 'NF {printf "%s\\n", $0}' infra/local/rsa_local_pub_NEW.pem
#      (Copy output into KONG_RSA_PUBLIC_KEY below with \n escaping)
#
#   5. Replace the old key files:
#      mv infra/local/rsa_local_NEW.pem infra/local/rsa_local.pem
#      mv infra/local/rsa_local_pub_NEW.pem infra/local/rsa_local_pub.pem
#
#   6. Restart the local stack:
#      docker compose down && docker compose up
#
RSA_PRIVATE_KEY=REPLACE_ME_WITH_PRIVATE_KEY_PEM_CONTENT

# ── RSA public key (SPKI PEM) ─────────────────────────────────────────────────
# The matching public key for RSA_PRIVATE_KEY above.
# Kong uses this to validate JWTs. Extract from the private key with:
#   openssl rsa -in infra/local/rsa_local.pem -pubout -out infra/local/rsa_local_pub.pem
# Then paste as a single line with literal \n:
#   awk 'NF {printf "%s\\n", $0}' infra/local/rsa_local_pub.pem
#
# Example format (replace entirely):
#   KONG_RSA_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\nMIIB...\n-----END PUBLIC KEY-----\n
KONG_RSA_PUBLIC_KEY=REPLACE_ME_WITH_PUBLIC_KEY_PEM_CONTENT

# ── X-User-Id signing key ─────────────────────────────────────────────────────
# HMAC-SHA256 key used by Kong to sign X-User-Id headers and by internal
# services to verify them. Generate with:
#   openssl rand -hex 32
# Example format (replace entirely):
#   X_USER_ID_SIGNING_KEY=0a1b2c3d4e5f6a7b8c9d0e1f2a3b4c5d6e7f8a9b0c1d2e3f4a5b6c7d8e9f0a
X_USER_ID_SIGNING_KEY=REPLACE_ME_WITH_32_BYTE_HEX_KEY

# ── Stripe test secret key ────────────────────────────────────────────────────
# For local dev without real Stripe, set to exactly "test_mock":
#   STRIPE_SECRET_KEY=test_mock
# For real Stripe test transactions, use your test key from:
#   https://dashboard.stripe.com/test/apikeys (starts with sk_test_)
STRIPE_SECRET_KEY=test_mock

# ── Attendance QR signing key ────────────────────────────────────────────────
# Strong shared secret used by attendance-service to sign QR tokens.
# Generate with:
#   openssl rand -hex 32
QR_SIGNING_KEY=REPLACE_ME_WITH_32_BYTE_HEX_KEY
