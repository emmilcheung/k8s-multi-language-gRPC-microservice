# infra/local/secrets/mongodb.env
# Credentials for the MongoDB instance (ticket-service).
# Used by Bitnami chart via existingSecret: mongodb-secret
# Keys must match what the chart expects:
#   existingSecretPasswordKey: password  (mongo_user's password)
#   rootPasswordKey:           root-password
# NEVER commit this file with real credentials.
password=changeme-mongo-local
root-password=changeme-mongo-root-local
