# infra/local/secrets/postgres-auth.env
# Password for the auth-service PostgreSQL instance.
# Used by Bitnami chart via existingSecret: postgres-auth-secret
# Key must match secretKeys.userPasswordKey in values.yaml (password).
#
# NEVER commit this file with a real password.
# This file is gitignored. Copy and fill in a local dev password.
password=changeme-auth-local
