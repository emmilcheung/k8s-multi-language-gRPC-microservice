# payment-service environment variables
# Copy to .env and fill in real values. Never commit .env.

NODE_ENV=development
PORT=3001

# PostgreSQL connection string (payments database)
DATABASE_URL=postgresql://payments_user:payments_pass@localhost:5432/payments_db

# Stripe — use test keys from https://dashboard.stripe.com/test/apikeys
# Set to 'test_mock' to skip real Stripe calls in integration tests
STRIPE_SECRET_KEY=sk_test_replace_me

# Kafka broker addresses (comma-separated)
KAFKA_BROKERS=localhost:9092
