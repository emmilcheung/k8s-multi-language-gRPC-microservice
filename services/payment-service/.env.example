# payment-service environment variables
# Copy to .env and fill in real values. Never commit .env.

NODE_ENV=development
PORT=3001

# PostgreSQL connection string (payments database)
DATABASE_URL=postgresql://payments_user:payments_pass@localhost:5432/payments_db

# Stripe
# - Use `test_mock` for local/integration mock mode (no Stripe network calls).
# - Use a real `sk_test_...` key only when explicitly testing against Stripe.
STRIPE_SECRET_KEY=test_mock
# Webhook signing secret from the Stripe Dashboard → Webhooks → your endpoint.
# Required in production for real Stripe mode. Get via: stripe listen --print-secret
# Run in parallel: stripe listen --forward-to localhost:3001/api/payments/webhook
STRIPE_WEBHOOK_SECRET=whsec_test_placeholder

# Kafka broker addresses (comma-separated)
KAFKA_BROKERS=localhost:9092

# Local OpenTelemetry collector endpoint.
# Leave unset to run in no-op tracing mode.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# OTEL_SERVICE_NAME=payment-service
