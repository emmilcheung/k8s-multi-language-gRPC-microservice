# payment-service environment variables
# Copy to .env and fill in real values. Never commit .env.

NODE_ENV=development
PORT=3001

# PostgreSQL connection string (payments database)
DATABASE_URL=postgresql://payments_user:payments_pass@localhost:5432/payments_db

# Stripe
# - Use `test_mock` for local/integration mock mode (no Stripe network calls).
# - Use a real `sk_test_...` key only when explicitly testing against Stripe.
STRIPE_SECRET_KEY=test_mock

# Kafka broker addresses (comma-separated)
KAFKA_BROKERS=localhost:9092
