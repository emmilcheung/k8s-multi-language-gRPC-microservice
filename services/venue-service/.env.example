# venue-service environment variables
# Copy this file to .env and fill in the values before running locally.
# Do NOT commit .env — it is gitignored.

# ── Required ──────────────────────────────────────────────────────────────────

# PostgreSQL DSN for the dedicated venue database
DATABASE_URL=postgresql://venue_user:venue_pass@localhost:5435/venue_db

# Comma-separated Kafka broker addresses
KAFKA_BROKERS=localhost:9093

# ── Optional ──────────────────────────────────────────────────────────────────

# Redis URL — if unset, Redis health check and caching are disabled
REDIS_URL=redis://localhost:6379

# HTTP server port (default: 3003)
PORT=3003

# gRPC server port (default: 50052)
GRPC_PORT=50052

# Log level: debug | info | warn | error (default: info)
LOG_LEVEL=info

# Application environment tag (default: development)
APP_ENV=development

# OpenTelemetry collector endpoint — if unset, tracing runs in no-op mode
# OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4317
