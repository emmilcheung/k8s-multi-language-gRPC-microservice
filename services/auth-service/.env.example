NODE_ENV=development
PORT=3000

# PostgreSQL connection string (docker-compose postgres-auth)
DATABASE_URL=postgresql://auth_user:auth_pass@localhost:5432/auth_db

# RSA 4096 private key for RS256 JWT signing.
# In development: generate with: openssl genrsa -out rsa_private.pem 4096
# Paste the PEM content here with literal \n replacing newlines, OR
# base64-encode the PEM file: base64 -i rsa_private.pem | tr -d '\n'
RSA_PRIVATE_KEY=REPLACE_WITH_PEM_OR_BASE64

# JWT access token expiry (default: 15m)
JWT_EXPIRY=15m

# Access-token cookie name. Must match Kong JWT_COOKIE_NAME and client JWT_COOKIE_NAME.
JWT_COOKIE_NAME=token

# Refresh-token cookie name. Must match client REFRESH_COOKIE_NAME.
REFRESH_COOKIE_NAME=refreshToken

# Refresh token lifetime in seconds (must match Redis TTL and cookie max-age).
REFRESH_TOKEN_TTL_SECONDS=604800

# Refresh cookie path. Use "/" for seamless SSR/middleware refresh.
REFRESH_COOKIE_PATH=/

# SameSite policies for auth cookies.
ACCESS_TOKEN_COOKIE_SAME_SITE=strict
REFRESH_TOKEN_COOKIE_SAME_SITE=strict

# Cookie domain (leave as localhost for local dev)
COOKIE_DOMAIN=localhost

# Local OpenTelemetry collector endpoint.
# Leave unset to run in no-op tracing mode.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# OTEL_SERVICE_NAME=auth-service
