# Environment variables for the client service.
# Copy to .env and fill in real values. NEVER commit .env.

# ─── Public (browser-facing, must start with NEXT_PUBLIC_) ────────────────────
# Base URL of the API gateway (Kong), reachable from the browser.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Stripe publishable key (public, safe to expose in browser).
# Get this from https://dashboard.stripe.com/apikeys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# ─── Private (server-side only) ───────────────────────────────────────────────
# Cluster-internal URL for Server Components / Server Actions to reach Kong/services.
INTERNAL_API_URL=http://localhost:8000

# Session cookie names (must match auth-service and Kong JWT_COOKIE_NAME).
JWT_COOKIE_NAME=token
REFRESH_COOKIE_NAME=refreshToken

# Fallback cookie policy/path if upstream Set-Cookie attributes are missing.
ACCESS_TOKEN_COOKIE_SAME_SITE=strict
REFRESH_TOKEN_COOKIE_SAME_SITE=strict
ACCESS_TOKEN_COOKIE_PATH=/
REFRESH_COOKIE_PATH=/

# Refresh trigger window in seconds (client asks auth-service to rotate token
# when access token is close to expiry).
SESSION_REFRESH_SKEW_SECONDS=30

# GraphQL Federation endpoint for server-side requests.
# Route through Kong so JWT validation and signed identity propagation match production.
GRAPHQL_API_URL=http://localhost:8000/graphql

# Browser-visible GraphQL endpoint. Route through Kong so the browser stays on the same auth path.
NEXT_PUBLIC_GRAPHQL_API_URL=http://localhost:8000/graphql

# Local OpenTelemetry collector endpoint for server-side traces.
# Leave unset to run the client in no-op tracing mode.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# OTEL_SERVICE_NAME=client

# Next.js telemetry — set to 1 to disable.
NEXT_TELEMETRY_DISABLED=1

# ─── Virtual waiting room (Plan 2) ────────────────────────────────────────────
# The gate is OFF unless QUEUE_GATE_ARMED=true. When armed, un-admitted visitors
# are 302'd to the waiting room, but only on the purchase-start pages of the event
# in QUEUE_EVENT_ID (its ticket id): /tickets/<id>, /tickets/<id>/seats and
# /tickets/<id>/plans/*. Every other page, including orders and checkout, is open. An admitted visitor is sent to sign in if needed,
# then the admission token is redeemed through Kong (/api/queue/redeem) for a pass
# bound to that account, carried in the qq_pass cookie. Kong must be armed for the
# same event (services/kong-gateway, QUEUE_GATE_ARMED / QUEUE_EVENT_ID).
QUEUE_GATE_ARMED=false
QUEUE_URL=http://localhost:4100
# Must equal the queue-service Queue__HmacSecret (min 32 chars).
QUEUE_HMAC_SECRET=dev-secret-change-me-32-chars-minimum
QUEUE_EVENT_ID=
QUEUE_PASS_COOKIE=qq_pass
