# Environment variables for the client service.
# Copy to .env and fill in real values. NEVER commit .env.

# ─── Public (browser-facing, must start with NEXT_PUBLIC_) ────────────────────
# Base URL of the API gateway (Kong), reachable from the browser.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Stripe publishable key (public, safe to expose in browser).
# Get this from https://dashboard.stripe.com/apikeys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# ─── Private (server-side only) ───────────────────────────────────────────────
# Cluster-internal URL for Server Components / Server Actions to reach Kong/services.
INTERNAL_API_URL=http://localhost:8000

# Session cookie names (must match auth-service and Kong JWT_COOKIE_NAME).
JWT_COOKIE_NAME=token
REFRESH_COOKIE_NAME=refreshToken

# Fallback cookie policy/path if upstream Set-Cookie attributes are missing.
ACCESS_TOKEN_COOKIE_SAME_SITE=strict
REFRESH_TOKEN_COOKIE_SAME_SITE=strict
ACCESS_TOKEN_COOKIE_PATH=/
REFRESH_COOKIE_PATH=/

# Refresh trigger window in seconds (client asks auth-service to rotate token
# when access token is close to expiry).
SESSION_REFRESH_SKEW_SECONDS=30

# Local OpenTelemetry collector endpoint for server-side traces.
# Leave unset to run the client in no-op tracing mode.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# OTEL_SERVICE_NAME=client

# Next.js telemetry — set to 1 to disable.
NEXT_TELEMETRY_DISABLED=1
