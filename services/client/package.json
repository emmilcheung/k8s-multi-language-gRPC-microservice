{
  "name": "client",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "pnpm": {
    "overrides": {
      "path-to-regexp": "8.4.2",
      "picomatch": "2.3.2",
      "vite": "8.0.5",
      "fast-uri": "3.1.2",
      "lodash": "^4.18.1"
    }
  },
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:observability-report": "node ./scripts/generate-observability-report.mjs",
    "schema:fetch": "tsx ./scripts/fetch-schema.ts",
    "codegen": "pnpm schema:fetch && graphql-codegen --config codegen.ts",
    "codegen:check": "pnpm schema:fetch && graphql-codegen --config codegen.ts --check",
    "prebuild": "pnpm codegen"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/api-logs": "^0.214.0",
    "@opentelemetry/sdk-logs": "^0.214.0",
    "@vercel/otel": "^2.1.1",
    "@xyflow/react": "^12.10.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "@graphql-typed-document-node/core": "^3.2.0",
    "@urql/exchange-retry": "^2.0.0",
    "graphql": "^16.13.2",
    "lucide-react": "^0.577.0",
    "next": "16.2.6",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "set-cookie-parser": "^3.1.0",
    "shadcn": "^4.1.0",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "urql": "^5.0.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/set-cookie-parser": "^2.4.10",
    "@graphql-codegen/cli": "^5.0.6",
    "@graphql-codegen/typed-document-node": "^5.1.2",
    "@graphql-codegen/typescript": "^4.1.6",
    "@graphql-codegen/typescript-operations": "^4.6.1",
    "@graphql-eslint/eslint-plugin": "^4.4.0",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "tsx": "^4.20.6",
    "jsdom": "^29.0.1",
    "kafkajs": "^2.2.4",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.0"
  }
}
