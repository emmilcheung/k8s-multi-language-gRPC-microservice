# ticket-service environment variables
# Copy this file to .env and fill in the real values.
# Never commit .env — only .env.example.

# Application
APP_ENV=development
PORT=3001
LOG_LEVEL=info

# MongoDB — service owns this database exclusively
MONGO_URI=mongodb://localhost:27017
MONGO_DB=tickets

# Kafka — comma-separated list of brokers
KAFKA_BROKERS=localhost:9092
