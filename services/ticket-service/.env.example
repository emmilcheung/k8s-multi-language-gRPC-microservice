# ticket-service environment variables
# Copy this file to .env and fill in the real values.
# Never commit .env — only .env.example.

# Application
APP_ENV=development
PORT=3001
LOG_LEVEL=info

# gRPC server port (order-service calls this)
GRPC_PORT=9090

# MongoDB — service owns this database exclusively
MONGO_URI=mongodb://localhost:27017
MONGO_DB=tickets

# Kafka — comma-separated list of brokers
KAFKA_BROKERS=localhost:9092

# Optional Redis cache (cache disabled when empty)
REDIS_URL=redis://localhost:6379
