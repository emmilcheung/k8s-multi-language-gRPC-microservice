extend schema
  @link(url: "https://specs.apollo.dev/federation/v2.9", import: ["@key", "@tag"])

type Ticket @key(fields: "id") {
  id: ID!
  title: String!
  price: Int!
  priceDecimal: String!
  userId: ID!
  orderId: ID
  quota: Int!
  reserved: Int!
  sold: Int!
  available: Int!
  maxPerUser: Int
  ticketType: TicketType!
  seatingPlan: SeatingPlan
  event: TicketEvent
  createdAt: String!
  updatedAt: String!
}

type TicketEvent {
  title: String!
  description: String
  startsAt: String!
  endsAt: String
  imageUrl: String
  venueName: String
  venueAddress: String
}

type SeatingPlan @key(fields: "id", resolvable: false) {
  id: ID!
}

enum TicketType {
  GENERAL_ADMISSION
  SEATED
}

input TicketFilter {
  availableOnly: Boolean
  ticketType: TicketType
}

type TicketEdge {
  node: Ticket!
  cursor: String!
}

type PageInfo {
  hasNextPage: Boolean!
  endCursor: String
}

type TicketConnection {
  edges: [TicketEdge!]!
  pageInfo: PageInfo!
}

type Query {
  # Legacy: returns the full list, no filter. Kept for backward compatibility.
  # Prefer `ticketsConnection` for new operations.
  tickets: [Ticket!]!
  # Paginated + filterable list. Phase 2 addition.
  ticketsConnection(filter: TicketFilter, first: Int, after: String): TicketConnection!
  ticket(id: ID!): Ticket
}

type Mutation {
  createTicket(input: CreateTicketInput!): Ticket!
  updateTicket(id: ID!, input: UpdateTicketInput!): Ticket!
}

input TicketEventInput {
  title: String
  description: String
  startsAt: String!
  endsAt: String
  imageUrl: String
  venueName: String
  venueAddress: String
}

input CreateTicketInput {
  title: String!
  price: Int!
  quota: Int!
  maxPerUser: Int
  ticketType: TicketType!
  event: TicketEventInput!
}

input UpdateTicketInput {
  title: String
  price: Int
  quota: Int
  maxPerUser: Int
  event: TicketEventInput
}
