extend schema
  @link(url: "https://specs.apollo.dev/federation/v2.9", import: ["@key", "@tag"])

type Order @key(fields: "id") {
  id: ID!
  userId: ID!
  ticket: OrderTicket!
  quantity: Int!
  status: OrderStatus!
  expiresAt: String
  createdAt: String!
  # Reserved seats for seated orders; empty for GA orders.
  seats: [OrderSeat!]!
  # Fee breakdown (computed on read)
  subtotal: String!
  serviceFee: String!
  facilityFee: String!
  tax: String!
  total: String!
  # Federation edge: payment is owned by payment-service.
  # Resolved by emitting Payment(__typename, orderId); router fetches the rest.
  payment: Payment
}

type OrderTicket {
  id: ID!
  title: String!
  price: String!
}

type OrderSeat {
  seatId: ID!
  sectionId: ID!
  seatLabel: String!
  price: String!
}

# Stub for the federated Payment entity (owned by payment-service).
type Payment @key(fields: "orderId", resolvable: false) {
  orderId: ID!
}

type User @key(fields: "id") {
  id: ID!
  orders: [Order!]! @tag(name: "self-only")
}

type RefundEligibility {
  orderId: ID!
  eligible: Boolean!
  reason: String
  refundableAmount: Int!
  cutoffAt: String
}

enum OrderStatus {
  CREATED
  AWAITING_PAYMENT
  COMPLETE
  CANCELLED
}

type Query {
  order(id: ID!): Order
  orders: [Order!]!
  refundEligibility(orderId: ID!): RefundEligibility
}

type Mutation {
  createOrder(input: CreateOrderInput!): Order!
  cancelOrder(id: ID!): Order!
  createSeatedOrder(input: CreateSeatedOrderInput!): Order!
}

input CreateOrderInput {
  ticketId: ID!
  quantity: Int!
}

input CreateSeatedOrderInput {
  ticketId: ID!
  quantity: Int!
  planId: ID!
  seatIds: [ID!]
  sectionId: ID
  attendees: [AttendeeInput!]
}

input AttendeeInput {
  seatId: ID!
  name: String!
}
