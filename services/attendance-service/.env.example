# attendance-service environment variables
# Copy this file to .env and fill in the values for local development.

# ── General ───────────────────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=info

# HTTP port for the Echo server
HTTP_PORT=3007

# ── PostgreSQL ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://attendance_user:attendance_pass@localhost:5432/attendance_db?sslmode=disable

# ── Kafka ─────────────────────────────────────────────────────────────────────
KAFKA_BROKERS=localhost:9092

# Optional SASL/TLS (leave blank for PLAINTEXT in dev)
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_SASL_MECHANISM=
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=
KAFKA_SSL_CA_LOCATION=

# ── QR Token Signing ─────────────────────────────────────────────────────────
# Must be at least 32 characters. Rotate via token_version field — never reuse.
QR_SIGNING_KEY=change-me-to-a-strong-random-32-char-key

# ── Internal gRPC dependencies ───────────────────────────────────────────────
# WS3 organizer policy ownership check looks up ticket owner from ticket-service.
TICKET_SERVICE_URL=localhost:50051

# ── Kong Gateway ─────────────────────────────────────────────────────────────
# Kong injects X-User-Id; optional HMAC signature verification.
X_USER_ID_SIGNING_KEY=

# ── OpenTelemetry ─────────────────────────────────────────────────────────────
# Optional. Accepts host:port or full URL. Leave blank to disable tracing.
OTEL_EXPORTER_OTLP_ENDPOINT=
