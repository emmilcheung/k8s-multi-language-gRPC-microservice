# Git repository root-level .gitignore

# Legacy reference (do not version control)
/legacy

# Environment files (local secrets)
.env
.env.local
.env.*.local

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Build artifacts
dist/
build/
target/
*.o
*.a
*.so

# Dependencies
node_modules/
vendor/
go.sum.local

# Test artifacts
*.test
coverage.out
*.cover
.playwright-mcp

# Local Kubernetes secret env files (contain real passwords — never commit)
infra/local/secrets/*.env
infra/local/secrets.env

# RSA key files (local JWT signing keys — never commit)
infra/local/rsa_local*.pem

# Terraform
.terraform/
*.tfstate
*.tfstate.*
.terraformrc
# Per-environment backend config and var files contain account IDs — never commit
infra/terraform/environments/**/backend.hcl
infra/terraform/environments/**/*.tfvars

# Kong gateway — rendered output (build artifact, never commit)
services/kong-gateway/kong.yml

# Docker
docker-compose.override.yml.local

# OS
.DS_Store
Thumbs.db

# Claude
.claude/settings.local.json
.worktrees/
.superpowers/
