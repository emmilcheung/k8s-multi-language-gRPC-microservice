{
  "uid": "services-red",
  "title": "Services — RED Metrics",
  "tags": [
    "ticketing",
    "red"
  ],
  "schemaVersion": 36,
  "version": 2,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "title": "Request Rate (req/s)",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          }
        }
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_requests_total[5m])) by (job)",
          "legendFormat": "{{job}}"
        },
        {
          "refId": "B",
          "expr": "sum(rate(ticket_service_requests_total[5m])) by (job)",
          "legendFormat": "{{job}}"
        },
        {
          "refId": "C",
          "expr": "sum(rate(venue_service_requests_total[5m])) by (job)",
          "legendFormat": "{{job}}"
        },
        {
          "refId": "D",
          "expr": "sum(rate(expiration_service_requests_total[5m])) by (job)",
          "legendFormat": "{{job}}"
        },
        {
          "refId": "E",
          "expr": "sum(rate(http_server_requests_seconds_count[5m])) by (job)",
          "legendFormat": "{{job}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "Error Rate (%)",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          }
        }
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_requests_total{status_code=~\"5..\"}[5m])) by (job) / sum(rate(http_requests_total[5m])) by (job) * 100",
          "legendFormat": "{{job}}"
        },
        {
          "refId": "B",
          "expr": "sum(rate(ticket_service_requests_total{code=~\"5..\"}[5m])) by (job) / sum(rate(ticket_service_requests_total[5m])) by (job) * 100",
          "legendFormat": "{{job}}"
        },
        {
          "refId": "C",
          "expr": "sum(rate(venue_service_requests_total{code=~\"5..\"}[5m])) by (job) / sum(rate(venue_service_requests_total[5m])) by (job) * 100",
          "legendFormat": "{{job}}"
        },
        {
          "refId": "D",
          "expr": "sum(rate(http_server_requests_seconds_count{status=~\"5..\"}[5m])) by (job) / sum(rate(http_server_requests_seconds_count[5m])) by (job) * 100",
          "legendFormat": "{{job}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "P99 Latency",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          }
        }
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.99, sum(rate(http_request_duration_seconds_bucket[5m])) by (le, job))",
          "legendFormat": "{{job}} p99"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.99, sum(rate(ticket_service_request_duration_seconds_bucket[5m])) by (le, job))",
          "legendFormat": "{{job}} p99"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum(rate(venue_service_request_duration_seconds_bucket[5m])) by (le, job))",
          "legendFormat": "{{job}} p99"
        },
        {
          "refId": "D",
          "expr": "histogram_quantile(0.99, sum(rate(expiration_service_request_duration_seconds_bucket[5m])) by (le, job))",
          "legendFormat": "{{job}} p99"
        },
        {
          "refId": "E",
          "expr": "histogram_quantile(0.99, sum(rate(http_server_requests_seconds_bucket[5m])) by (le, job))",
          "legendFormat": "{{job}} p99"
        }
      ]
    },
    {
      "id": 4,
      "title": "Go Goroutines (runtime health)",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          }
        }
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "go_goroutines",
          "legendFormat": "{{job}}"
        }
      ]
    },
    {
      "id": 5,
      "title": "Kafka Consumer Commits/s (order-service)",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          }
        }
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(kafka_consumer_fetch_manager_fetch_total[5m])) by (job, client_id)",
          "legendFormat": "{{job}} {{client_id}}"
        }
      ]
    },
    {
      "id": 6,
      "title": "Node.js Event Loop Lag p99 (ms)",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          }
        }
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "nodejs_eventloop_lag_p99_seconds * 1000",
          "legendFormat": "{{job}} event-loop p99"
        }
      ]
    }
  ]
}
