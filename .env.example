# Root-level .env — dev environment secrets
# Copy this file to .env and fill in real values.
# .env is gitignored — NEVER commit .env to source control.

# ── auth-service ─────────────────────────────────────────────────────────────
# RS256 private key (PKCS#8 PEM) used by auth-service to sign JWTs.
# To generate a new key pair (dev only):
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out private.pem
#   openssl rsa -in private.pem -pubout -out public.pem
RSA_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----
REPLACE_WITH_YOUR_RSA_PRIVATE_KEY_PEM
-----END PRIVATE KEY-----"

# ── kong-gateway ──────────────────────────────────────────────────────────────
# RS256 public key (SPKI PEM) used by Kong to validate JWTs signed by auth-service.
# Must be the public half of the RSA_PRIVATE_KEY above.
# Kong's build.sh inlines this at container startup — never baked into the image.
KONG_RSA_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----
REPLACE_WITH_YOUR_RSA_PUBLIC_KEY_PEM
-----END PUBLIC KEY-----"

# ── payment-service ───────────────────────────────────────────────────────────
# Stripe secret API key. Use "test_mock" for local dev without a real Stripe account.
# Get real test keys from: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=test_mock

# ── shared auth/session config (client + Kong + auth-service) ────────────────
# Keep these values aligned across auth-service, Kong JWT plugin, and client.
JWT_COOKIE_NAME=token
REFRESH_COOKIE_NAME=refreshToken
REFRESH_TOKEN_TTL_SECONDS=604800
REFRESH_COOKIE_PATH=/
ACCESS_TOKEN_COOKIE_SAME_SITE=strict
REFRESH_TOKEN_COOKIE_SAME_SITE=strict
# Keep empty for host-only cookies in local dev. Set to a real domain in shared envs.
COOKIE_DOMAIN=
