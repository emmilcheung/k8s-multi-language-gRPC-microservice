// Module containing generated gRPC stubs for the ticketing platform.
// Regenerate with: make proto  (from repo root)
// This module is consumed by ticket-service via a local replace directive.
module github.com/org/ticketing/libs/grpc-stubs/go

go 1.23

require (
	google.golang.org/grpc v1.79.2
	google.golang.org/protobuf v1.36.11
)
